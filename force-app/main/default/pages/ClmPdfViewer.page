<apex:page controller="ClmPdfViewerController" showHeader="false" sidebar="false" standardStylesheets="false" docType="html-5.0" applyHtmlTag="true" applyBodyTag="true">
    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #1a1a1a;
        }
        #viewer {
            width: 100%;
            height: 100%;
            border: 0;
            display: block;
            background: #fff;
        }
        #status {
            color: #fff;
            font-family: sans-serif;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            margin: 0;
        }
    </style>
    <p id="status">Loading slide...</p>
    <iframe id="viewer" title="CLM PDF" style="display:none;"></iframe>
    <script>
        (function () {
            var params = new URLSearchParams(window.location.search);
            var docId = params.get('docId');
            var publicUrl = params.get('publicUrl');
            var page = parseInt(params.get('page') || '1', 10);
            var statusEl = document.getElementById('status');
            var viewer = document.getElementById('viewer');

            function notifyParent(type, detail) {
                try {
                    if (window.parent && window.parent !== window) {
                        window.parent.postMessage(Object.assign({ type: type }, detail || {}), '*');
                    }
                } catch (ignore) {
                    /* postMessage can fail in hardened embed contexts */
                }
            }

            function showError(message) {
                statusEl.style.display = 'flex';
                statusEl.textContent = message;
                viewer.style.display = 'none';
                notifyParent('clm-pdf-error', { message: message });
            }

            if (!docId && !publicUrl) {
                showError('Missing document.');
                return;
            }

            // Navigation/embed is not subject to the CORS rules that block fetch().
            var base = publicUrl || ('/sfc/servlet.shepherd/document/download/' + encodeURIComponent(docId));
            base = String(base).split('#')[0];
            var src = base + '#page=' + (Number.isNaN(page) ? 1 : page);

            viewer.onload = function () {
                statusEl.style.display = 'none';
                viewer.style.display = 'block';
                notifyParent('clm-pdf-ready', { page: page });
            };
            viewer.onerror = function () {
                showError('Unable to load slide.');
            };
            viewer.src = src;

            // Some browsers never fire iframe load for PDF plugins.
            window.setTimeout(function () {
                if (viewer.style.display === 'none' && statusEl.textContent === 'Loading slide...') {
                    statusEl.style.display = 'none';
                    viewer.style.display = 'block';
                    notifyParent('clm-pdf-ready', { page: page });
                }
            }, 2000);

            window.addEventListener('message', function (event) {
                if (!event.data || event.data.type !== 'clm-pdf-page') {
                    return;
                }
                var nextPage = parseInt(event.data.page, 10);
                if (Number.isNaN(nextPage)) {
                    return;
                }
                page = nextPage;
                viewer.src = base + '#page=' + page + '&t=' + Date.now();
            });
        })();
    </script>
</apex:page>
