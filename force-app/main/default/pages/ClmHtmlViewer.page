<apex:page showHeader="false" sidebar="false" standardStylesheets="false" docType="html-5.0" applyHtmlTag="true" applyBodyTag="true">
    <c:PendingPaymentAlert />
    <style>
        html, body, iframe { margin: 0; padding: 0; width: 100%; height: 100%; border: 0; }
    </style>
    <iframe id="clmFrame" title="CLM Content"></iframe>
    <script>
        (function () {
            var params = new URLSearchParams(window.location.search);
            var src = params.get('src');
            if (src) {
                document.getElementById('clmFrame').src = src;
            }
            window.addEventListener('message', function (event) {
                if (event.data && event.data.type === 'clm-slide-change') {
                    parent.postMessage(event.data, '*');
                }
            });
        })();
    </script>
</apex:page>