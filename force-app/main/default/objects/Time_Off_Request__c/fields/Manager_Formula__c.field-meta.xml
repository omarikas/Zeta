<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Manager_Formula__c</fullName>
    <description>Creator&apos;s manager display name (FirstName + LastName; avoids compound Name in cross-object formula).</description>
    <externalId>false</externalId>
    <formula>IF(
  ISBLANK(CreatedBy.ManagerId),
  &quot;&quot;,
  TRIM(BLANKVALUE(CreatedBy.Manager.FirstName, &quot;&quot;) &amp; &quot; &quot; &amp; BLANKVALUE(CreatedBy.Manager.LastName, &quot;&quot;))
)</formula>
    <inlineHelpText>Automatically reflects the manager on the user who created this request.</inlineHelpText>
    <label>Manager</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
