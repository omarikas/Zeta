<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lock_Non_Draft</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(ISPICKVAL(Stage__c, &apos;Draft&apos;)),
  NOT(ISCHANGED(Stage__c))
)</errorConditionFormula>
    <errorMessage>Only Draft records can be edited. Use Recall to bring a submitted request back to Draft.</errorMessage>
</ValidationRule>
