# This file is used for Git repositories to specify intentionally untracked files that Git should ignore.
# If you are not using git, you can delete this file. For more information see: https://git-scm.com/docs/gitignore
# For useful gitignore templates see: https://github.com/github/gitignore

# Ignore everything at root level
*

# Unignore directories (needed for traversal)
!*/

# Unignore the offline directory and its contents
!offline/
!offline/**

# Unignore force-app directory (needed for LWC components during build)
!force-app/
!force-app/**

# Unignore GitHub Actions workflows
!.github/
!.github/workflows/**

# Unignore vercel.json for CORS configuration
!vercel.json

# Unignore api directory for Vercel serverless functions
!api/
!api/**

# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env
.env.local
**/.env.local

# PWA build output (committed for GitHub Pages deployment)
# offline/dist/

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/
.vercel
